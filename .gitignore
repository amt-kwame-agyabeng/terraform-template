# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
terraform.tfstate.d/

# Terraform plan files
*.tfplan

# Terraform crash logs
crash.log
crash.*.log

# Local Terraform variable files
terraform.tfvars
terraform.tfvars.json

# Keep example and environment configuration files
!terraform.tfvars.example
!environments/*.tfvars

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc
